datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  // Vercel serverless runs on Amazon Linux (OpenSSL 3.0.x); generate that engine too so it
  // exists in node_modules. `native` keeps local dev (macOS/Linux) working.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ── Enums ────────────────────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  BEFORE_AFTER
  YOUTUBE
  VIMEO
  AI
  LOTTIE
}

enum ProjectMediaType {
  GALLERY
  VIDEO
  BEFORE_AFTER
}

enum HomepageSectionType {
  HERO
  SERVICES
  PROJECTS
  CLIENTS
  STATS
  TESTIMONIALS
  FAQ
  CTA
  BEFORE_AFTER
  PROCESS
}

// ── Operational entities ─────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  roleId       String   @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id])
  active       Boolean  @default(true)
  version      Int      @default(1)

  clientsCreated    Client[]    @relation("clientCreatedBy")
  clientsUpdated    Client[]    @relation("clientUpdatedBy")
  servicesCreated   Service[]   @relation("serviceCreatedBy")
  servicesUpdated   Service[]   @relation("serviceUpdatedBy")
  projectsCreated   Project[]   @relation("projectCreatedBy")
  projectsUpdated   Project[]   @relation("projectUpdatedBy")
  homepageSectionsCreated   HomepageSection[]   @relation("homepageSectionCreatedBy")
  homepageSectionsUpdated   HomepageSection[]   @relation("homepageSectionUpdatedBy")
  testimonialsCreated       Testimonial[]       @relation("testimonialCreatedBy")
  testimonialsUpdated       Testimonial[]       @relation("testimonialUpdatedBy")
  pagesCreated       Page[]   @relation("pageCreatedBy")
  pagesUpdated       Page[]   @relation("pageUpdatedBy")
  refreshTokens      RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions String[]
  isOwner     Boolean  @default(false)
  version     Int      @default(1)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  hashedToken String
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  expiresAt   DateTime
  revoked     Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([hashedToken])
}

model Media {
  id         String    @id @default(uuid()) @db.Uuid
  type       MediaType
  r2Key      String
  url        String
  posterUrl  String?
  width      Int?
  height     Int?
  alt        String?
  folderId   String?   @db.Uuid
  folder     Folder?   @relation(fields: [folderId], references: [id])
  tags       String[]
  usageCount Int       @default(0)
  version    Int       @default(1)
  confirmed  Boolean   @default(false)

  clientLogos      Client[]
  serviceIcons     Service[]
  settingsLogos    Settings[] @relation("SettingsLogo")
  settingsFavicons Settings[] @relation("SettingsFavicon")
  projectMedia     ProjectMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@index([type])
}

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderHierarchy")

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ── Settings (singleton) ─────────────────────────────────────────────────

model Settings {
  id           String   @id @default(uuid()) @db.Uuid
  siteName     String
  logoId       String?  @db.Uuid
  logo         Media?   @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: Restrict)
  faviconId    String?  @db.Uuid
  favicon      Media?   @relation("SettingsFavicon", fields: [faviconId], references: [id], onDelete: Restrict)
  socialLinks  Json     @default("{}")
  seoDefaults  Json?    @default("{}")
  analyticsIds Json?    @default("{}")
  contact      Json?    @default("{}")
  version      Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Content types (each embeds the Content Engine base fields) ────────────

model Client {
  id   String @id @default(uuid()) @db.Uuid
  name String
  logoId String? @db.Uuid
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: Restrict)
  website String?
  // How the client is shown on the public site: "both" (logo + name), "name", or "logo".
  displayMode String @default("both")
  order   Int     @default(0)

  // Content Engine base fields
  status      ContentStatus @default(DRAFT)
  slug        String
  featured    Boolean       @default(false)
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImage         String?
  seoTwitterCard     String?
  seoStructuredData  Json?
  seoRobots          String?
  locale        String     @default("en")
  version       Int        @default(1)
  publishedAt   DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  createdBy   User?   @relation("clientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("clientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@unique([slug, locale])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([order])
}

model Service {
  id   String @id @default(uuid()) @db.Uuid
  name String
  description String?
  iconMediaId String? @db.Uuid
  iconMedia   Media?  @relation(fields: [iconMediaId], references: [id], onDelete: Restrict)
  order       Int     @default(0)

  status      ContentStatus @default(DRAFT)
  slug        String
  featured    Boolean       @default(false)
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImage         String?
  seoTwitterCard     String?
  seoStructuredData  Json?
  seoRobots          String?
  locale        String     @default("en")
  version       Int        @default(1)
  publishedAt   DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  createdBy   User?   @relation("serviceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("serviceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subServices SubService[]
  projects    ProjectService[]

  @@unique([slug, locale])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([order])
}

model SubService {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  order       Int      @default(0)

  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([order])
}

model Project {
  id    String @id @default(uuid()) @db.Uuid
  title String
  overview    String?
  description String?
  challenge   String?
  solution    String?
  results     String?
  externalLinks Json? @default("[]")
  order       Int      @default(0)
  clientId    String?  @db.Uuid
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  status      ContentStatus @default(DRAFT)
  slug        String
  featured    Boolean       @default(false)
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImage         String?
  seoTwitterCard     String?
  seoStructuredData  Json?
  seoRobots          String?
  locale        String     @default("en")
  version       Int        @default(1)
  publishedAt   DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  createdBy   User?   @relation("projectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("projectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services         ProjectService[]
  media            ProjectMedia[]
  relatedProjects  RelatedProject[]  @relation("RelatedProjectA")
  relatedTo        RelatedProject[]  @relation("RelatedProjectB")

  @@unique([slug, locale])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([clientId])
  @@index([order])
}

model HomepageSection {
  id      String               @id @default(uuid()) @db.Uuid
  type    HomepageSectionType
  enabled Boolean              @default(true)
  order   Int                  @default(0)
  config  Json                 @default("{}")

  status      ContentStatus @default(DRAFT)
  slug        String
  featured    Boolean       @default(false)
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImage         String?
  seoTwitterCard     String?
  seoStructuredData  Json?
  seoRobots          String?
  locale        String     @default("en")
  version       Int        @default(1)
  publishedAt   DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  createdBy   User?   @relation("homepageSectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("homepageSectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([order])
  @@index([type])
}

model Testimonial {
  id String @id @default(uuid()) @db.Uuid

  status      ContentStatus @default(DRAFT)
  slug        String
  featured    Boolean       @default(false)
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImage         String?
  seoTwitterCard     String?
  seoStructuredData  Json?
  seoRobots          String?
  locale        String     @default("en")
  version       Int        @default(1)
  publishedAt   DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  createdBy   User?   @relation("testimonialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("testimonialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
}

model Page {
  id String @id @default(uuid()) @db.Uuid

  status      ContentStatus @default(DRAFT)
  slug        String
  featured    Boolean       @default(false)
  seoTitle           String?
  seoMetaDescription String?
  seoCanonicalUrl    String?
  seoOgImage         String?
  seoTwitterCard     String?
  seoStructuredData  Json?
  seoRobots          String?
  locale        String     @default("en")
  version       Int        @default(1)
  publishedAt   DateTime?
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  createdBy   User?   @relation("pageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("pageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
}

// ── Join tables ──────────────────────────────────────────────────────────

model ProjectService {
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([projectId, serviceId])
}

model ProjectMedia {
  projectId String           @db.Uuid
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String           @db.Uuid
  media     Media            @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  type      ProjectMediaType
  order     Int              @default(0)

  @@id([projectId, mediaId, type])
  @@index([mediaId])
}

model RelatedProject {
  projectId        String @db.Uuid
  project          Project @relation("RelatedProjectA", fields: [projectId], references: [id], onDelete: Cascade)
  relatedProjectId String @db.Uuid
  relatedProject   Project @relation("RelatedProjectB", fields: [relatedProjectId], references: [id], onDelete: Cascade)

  @@id([projectId, relatedProjectId])
}

// Public contact enquiries captured from the marketing site (FR-021).
model Message {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  message   String
  // Snapshot of the budget option the enquirer picked (free text, survives Budget deletion).
  budget    String?
  locale    String   @default("en")
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
  @@index([createdAt])
}

// Selectable budget/plan options for the public contact form. Managed in the CMS.
model Budget {
  id        String   @id @default(uuid()) @db.Uuid
  labelEn   String
  labelAr   String?
  // Free-text price/range including the currency the admin types, e.g. "$1k–$5k".
  amount    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([active])
}

// Client reviews shown on the marketing site. Not localized — one `quote` string is shown
// as-is on both the EN and AR sites. A light, toggleable list like Budget (no SEO/slug).
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  quote      String
  authorName String
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@index([active])
}
