datasource db {
  provider  = "postgresql"
  // App/runtime: Supabase POOLED connection (PgBouncer, port 6543).
  url       = env("DATABASE_URL")
  // Migrations: DIRECT connection (port 5432) — the pooler can't run DDL/migrations.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}
