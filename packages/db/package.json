{
  "name": "@studioflow/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
