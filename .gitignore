# ---------------------------------------------------------------------------
# StudioFlow — monorepo .gitignore
# Stack: pnpm + Turborepo · Next.js 15 (web, admin — backend built in) · Prisma/Postgres
# ---------------------------------------------------------------------------

# --- Dependencies ---------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Package manager stores / logs ---------------------------------------
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# --- Environment / secrets (NEVER commit — Constitution XVII) --------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# --- Build output ---------------------------------------------------------
dist/
build/
out/
lib/
# apps/admin/lib is source (session/media guards imported by every route), not build output.
!apps/admin/lib/
!apps/admin/lib/**
*.tsbuildinfo
next-env.d.ts

# --- Next.js (apps/web, apps/admin) ---------------------------------------
.next/
.vercel/

# --- Turborepo ------------------------------------------------------------
.turbo/

# --- Prisma ---------------------------------------------------------------
# Keep schema & migrations tracked; ignore generated client & local DBs.
**/generated/
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/*.db

# --- Testing / coverage ---------------------------------------------------
coverage/
*.lcov
.nyc_output/
playwright-report/
playwright/.cache/
test-results/

# --- Caches ---------------------------------------------------------------
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
*.tsbuildinfo

# --- Logs & runtime -------------------------------------------------------
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# --- Storage / uploads (media lives in Cloudinary, not the repo) ----------
uploads/
tmp/
temp/

# --- Editor / IDE ---------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- OS files -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
